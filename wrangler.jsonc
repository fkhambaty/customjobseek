{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customjobseek",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customjobseek",
      "database_id": "d6919300-3a73-4211-8884-e0c4acefce3d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MAIL_FROM": "CustomJobSeek <no-reply@funberrykids.in>",
    "OWNER_EMAIL": "fktiindia@gmail.com",
    "LEGAL_NAME": "Fakhruddin Khambaty",
    "LEGAL_ADDRESS": "Undri, Pune, 411060",
    "PAYMENTS_ENABLED": "true"
  },
  "triggers": {
    "crons": ["17 * * * *", "30 * * * *", "* * * * *"]
  },
  "observability": { "enabled": true }
}
